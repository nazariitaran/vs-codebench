{
  "name": "vs-codebench",
  "displayName": "VS CodeBench",
  "description": "A productivity extension that helps you organize your tasks, code notes, and bookmarks efficiently.",
  "version": "1.3.0",
  "publisher": "nazariitaran",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "productivity",
    "todo",
    "tasks",
    "bookmarks",
    "notes",
    "scratchpad",
    "organization",
    "utilities"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nazariitaran/vs-codebench.git"
  },
  "homepage": "https://github.com/nazariitaran/vs-codebench",
  "bugs": {
    "url": "https://github.com/nazariitaran/vs-codebench/issues"
  },
  "license": "MIT",
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:codebench-scratchpad"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-codebench.addTodo",
        "title": "Add Todo",
        "icon": "$(add)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.editTodo",
        "title": "Edit Todo",
        "icon": "$(edit)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.deleteTodo",
        "title": "Delete Todo",
        "icon": "$(trash)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.moveTodoUp",
        "title": "Move Todo Up",
        "icon": "$(arrow-up)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.moveTodoDown",
        "title": "Move Todo Down",
        "icon": "$(arrow-down)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.toggleTodo",
        "title": "Toggle Todo",
        "icon": "$(check)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addSubTodo",
        "title": "Add Sub-Todo",
        "icon": "$(add)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.showTodoStats",
        "title": "Show Todo Statistics",
        "icon": "$(info)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.clearCheckedTodos",
        "title": "Todos: Remove Checked",
        "icon": "$(clear-all)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.clearAllTodos",
        "title": "Todos: Clear All",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.clearAllBookmarks",
        "title": "Bookmarks: Clear All",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.toggleBookmark",
        "title": "Toggle Bookmark",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addBookmark",
        "title": "Add Bookmark",
        "icon": "$(add)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.editBookmark",
        "title": "Edit Bookmark",
        "icon": "$(pencil)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.deleteBookmark",
        "title": "Delete Bookmark",
        "icon": "$(trash)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.changeBookmarkColor",
        "title": "Change Bookmark Color",
        "icon": "$(symbol-color)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addFolder",
        "title": "Add Folder",
        "icon": "$(new-folder)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addRootFolder",
        "title": "New Bookmark Folder",
        "icon": "$(new-folder)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.editFolder",
        "title": "Edit Folder",
        "icon": "$(edit)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.deleteFolder",
        "title": "Delete Folder",
        "icon": "$(trash)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.createScratchpad",
        "title": "Create Scratchpad",
        "icon": "$(new-file)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.createScratchpadInFolder",
        "title": "Create Scratchpad Here",
        "icon": "$(new-file)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.saveUnsavedAsScratchpad",
        "title": "Save Unsaved File as Scratchpad",
        "icon": "$(notebook-state-success)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.openScratchFile",
        "title": "Open Scratchpad File",
        "icon": "$(file)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.renameScratchFile",
        "title": "Rename Scratchpad File",
        "icon": "$(edit)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.deleteScratchFile",
        "title": "Delete Scratchpad File",
        "icon": "$(trash)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.clearAllScratchpads",
        "title": "Scratchpads: Clear All",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addScratchpadFolder",
        "title": "Add Scratchpad Folder",
        "icon": "$(new-folder)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.addRootScratchpadFolder",
        "title": "New Scratchpad Folder",
        "icon": "$(new-folder)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.editScratchpadFolder",
        "title": "Edit Scratchpad Folder",
        "icon": "$(edit)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.deleteScratchpadFolder",
        "title": "Delete Scratchpad Folder",
        "icon": "$(trash)",
        "category": "CodeBench"
      },
      {
        "command": "vs-codebench.importScratchpads",
        "title": "Import Scratchpads from Directory",
        "category": "CodeBench"
      }
    ],
    "languageModelTools": [
      {
        "name": "codebench_get_bookmarks",
        "displayName": "Get Bookmarks",
        "userDescription": "Read bookmarks and bookmark folders from VS CodeBench.",
        "modelDescription": "Get VS CodeBench bookmarks and folders in the current workspace. Use this before bookmark mutations when you need bookmarkId or folderId values.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-bookmarks",
        "inputSchema": {
          "type": "object",
          "properties": {
            "fileUri": {
              "type": "string",
              "description": "Absolute file path or file:// URI. Optional filter to return bookmarks only for one file."
            },
            "folderId": {
              "type": "string",
              "description": "Optional folder ID to filter bookmarks by parent folder."
            },
            "includeFolders": {
              "type": "boolean",
              "description": "When true, include folder entries in the response."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_add_bookmark",
        "displayName": "Add Bookmark",
        "userDescription": "Create a bookmark in VS CodeBench.",
        "modelDescription": "Create a bookmark for a file and line in VS CodeBench. Line is zero-based. Use this for root-level bookmarks.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-add-bookmark",
        "inputSchema": {
          "type": "object",
          "required": ["fileUri", "line"],
          "properties": {
            "fileUri": {
              "type": "string",
              "description": "Absolute file path or file:// URI for the target file."
            },
            "line": {
              "type": "integer",
              "minimum": 0,
              "description": "Zero-based target line number."
            },
            "text": {
              "type": "string",
              "description": "Optional bookmark label (1-75 characters)."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_move_bookmark_to_folder",
        "displayName": "Move Bookmark To Folder",
        "userDescription": "Move an existing bookmark into a bookmark folder.",
        "modelDescription": "Place an existing VS CodeBench bookmark into a specific folder. Use get_bookmarks first to resolve bookmarkId and folderId.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-move-bookmark-folder",
        "inputSchema": {
          "type": "object",
          "required": ["bookmarkId", "folderId"],
          "properties": {
            "bookmarkId": {
              "type": "string",
              "description": "Existing bookmark ID to move into a folder."
            },
            "folderId": {
              "type": "string",
              "description": "Target bookmark folder ID."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_rename_bookmark",
        "displayName": "Rename Bookmark",
        "userDescription": "Rename an existing bookmark.",
        "modelDescription": "Update the text label for a VS CodeBench bookmark by bookmarkId.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-rename-bookmark",
        "inputSchema": {
          "type": "object",
          "required": ["bookmarkId", "text"],
          "properties": {
            "bookmarkId": {
              "type": "string",
              "description": "ID of bookmark to rename."
            },
            "text": {
              "type": "string",
              "description": "New bookmark label (1-75 characters)."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_set_bookmark_color",
        "displayName": "Set Bookmark Color",
        "userDescription": "Set bookmark color in VS CodeBench.",
        "modelDescription": "Set bookmark color by bookmarkId. Allowed values are default, red, green, yellow, and purple.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-bookmark-color",
        "inputSchema": {
          "type": "object",
          "required": ["bookmarkId", "color"],
          "properties": {
            "bookmarkId": {
              "type": "string",
              "description": "ID of bookmark to recolor."
            },
            "color": {
              "type": "string",
              "enum": ["default", "red", "green", "yellow", "purple"],
              "description": "Bookmark color name."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_remove_bookmark",
        "displayName": "Remove Bookmark",
        "userDescription": "Delete a bookmark from VS CodeBench.",
        "modelDescription": "Delete a VS CodeBench bookmark by bookmarkId.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-remove-bookmark",
        "inputSchema": {
          "type": "object",
          "required": ["bookmarkId"],
          "properties": {
            "bookmarkId": {
              "type": "string",
              "description": "ID of bookmark to delete."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_create_bookmark_folder",
        "displayName": "Create Bookmark Folder",
        "userDescription": "Create a bookmark folder in VS CodeBench.",
        "modelDescription": "Create a bookmark folder at root or under a parent folder. Folder depth limit is 3.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-create-folder",
        "inputSchema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Folder name (1-75 characters)."
            },
            "parentFolderId": {
              "type": "string",
              "description": "Optional parent folder ID."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_remove_bookmark_folder",
        "displayName": "Remove Bookmark Folder",
        "userDescription": "Delete a bookmark folder and its contents.",
        "modelDescription": "Delete a bookmark folder by folderId. By default this recursively removes all nested subfolders and bookmarks.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-remove-folder",
        "inputSchema": {
          "type": "object",
          "required": ["folderId"],
          "properties": {
            "folderId": {
              "type": "string",
              "description": "ID of folder to delete."
            },
            "force": {
              "type": "boolean",
              "description": "When false, deletion requires empty folder; when true, delete recursively."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_get_scratchpads",
        "displayName": "Get Scratchpads",
        "userDescription": "Read scratchpads from VS CodeBench.",
        "modelDescription": "List scratchpad metadata for the current workspace. By default this returns root-level scratchpads only, plus all folder metadata. Use folderId to inspect one folder or includeAll=true to list scratchpads across all folders. This tool does not return scratchpad content.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-scratchpads",
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "description": "Optional language filter, for example markdown or typescript."
            },
            "nameContains": {
              "type": "string",
              "description": "Optional case-insensitive substring for scratchpad name filtering."
            },
            "folderId": {
              "type": "string",
              "description": "Optional folder ID to filter scratchpads by parent folder."
            },
            "includeAll": {
              "type": "boolean",
              "description": "When true and folderId is omitted, return scratchpads from all folders instead of root-level only."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_get_scratchpad_content",
        "displayName": "Get Scratchpad Content",
        "userDescription": "Read content for one scratchpad by ID.",
        "modelDescription": "Get the full content of a specific VS CodeBench scratchpad by scratchpadId. Use get_scratchpads first to discover valid IDs.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-scratchpad-content",
        "inputSchema": {
          "type": "object",
          "required": ["scratchpadId"],
          "properties": {
            "scratchpadId": {
              "type": "string",
              "description": "ID of scratchpad whose content should be returned."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_create_scratchpad",
        "displayName": "Create Scratchpad",
        "userDescription": "Create a scratchpad in VS CodeBench.",
        "modelDescription": "Create a scratchpad with optional name, language, content, and parentFolderId. If name is omitted, a default scratchpad_<n>.<ext> name is generated. Use get_scratchpads first when you need a target folder ID.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-create-scratchpad",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Optional file name. If extension is omitted, one is added from language or .txt."
            },
            "language": {
              "type": "string",
              "description": "Optional language id, for example markdown or typescript."
            },
            "content": {
              "type": "string",
              "description": "Optional initial file content."
            },
            "parentFolderId": {
              "type": "string",
              "description": "Optional folder ID to create the scratchpad inside."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_update_scratchpad_content",
        "displayName": "Update Scratchpad Content",
        "userDescription": "Update the content of an existing scratchpad.",
        "modelDescription": "Update the full file content for an existing VS CodeBench scratchpad by scratchpadId. Use this to overwrite the entire content of a scratchpad.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-update-scratchpad-content",
        "inputSchema": {
          "type": "object",
          "required": ["scratchpadId", "content"],
          "properties": {
            "scratchpadId": {
              "type": "string",
              "description": "ID of scratchpad to update."
            },
            "content": {
              "type": "string",
              "description": "New content to write to the scratchpad file."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_rename_scratchpad",
        "displayName": "Rename Scratchpad",
        "userDescription": "Rename a scratchpad file.",
        "modelDescription": "Rename a VS CodeBench scratchpad by scratchpadId.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-rename-scratchpad",
        "inputSchema": {
          "type": "object",
          "required": ["scratchpadId", "newName"],
          "properties": {
            "scratchpadId": {
              "type": "string",
              "description": "ID of scratchpad to rename."
            },
            "newName": {
              "type": "string",
              "description": "New file name for the scratchpad."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_delete_scratchpad",
        "displayName": "Delete Scratchpad",
        "userDescription": "Delete a scratchpad file.",
        "modelDescription": "Delete a VS CodeBench scratchpad by scratchpadId.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-delete-scratchpad",
        "inputSchema": {
          "type": "object",
          "required": ["scratchpadId"],
          "properties": {
            "scratchpadId": {
              "type": "string",
              "description": "ID of scratchpad to delete."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_create_scratchpad_folder",
        "displayName": "Create Scratchpad Folder",
        "userDescription": "Create a scratchpad folder in VS CodeBench.",
        "modelDescription": "Create a scratchpad folder at root or under a parent folder. Folder depth limit is 5.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-create-scratchpad-folder",
        "inputSchema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Folder name (1-75 characters)."
            },
            "parentFolderId": {
              "type": "string",
              "description": "Optional parent folder ID."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_rename_scratchpad_folder",
        "displayName": "Rename Scratchpad Folder",
        "userDescription": "Rename a scratchpad folder in VS CodeBench.",
        "modelDescription": "Rename an existing scratchpad folder by folderId. Use get_scratchpads first to discover valid folder IDs.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-rename-scratchpad-folder",
        "inputSchema": {
          "type": "object",
          "required": ["folderId", "newName"],
          "properties": {
            "folderId": {
              "type": "string",
              "description": "ID of the scratchpad folder to rename."
            },
            "newName": {
              "type": "string",
              "description": "New folder name."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_move_scratchpad_to_folder",
        "displayName": "Move Scratchpad To Folder",
        "userDescription": "Move an existing scratchpad into a scratchpad folder.",
        "modelDescription": "Place an existing VS CodeBench scratchpad into a specific folder. Use get_scratchpads first to resolve scratchpadId and folderId. Omit folderId to move the scratchpad back to the root.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-move-scratchpad-folder",
        "inputSchema": {
          "type": "object",
          "required": ["scratchpadId"],
          "properties": {
            "scratchpadId": {
              "type": "string",
              "description": "Existing scratchpad ID to move into a folder."
            },
            "folderId": {
              "type": "string",
              "description": "Optional target scratchpad folder ID. Omit to move the scratchpad to the root."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_move_scratchpad_folder",
        "displayName": "Move Scratchpad Folder",
        "userDescription": "Move a scratchpad folder in VS CodeBench.",
        "modelDescription": "Move an existing scratchpad folder under another scratchpad folder. Use get_scratchpads first to resolve folder IDs. Omit targetFolderId to move the folder to the root.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-move-scratchpad-folder-node",
        "inputSchema": {
          "type": "object",
          "required": ["folderId"],
          "properties": {
            "folderId": {
              "type": "string",
              "description": "Existing scratchpad folder ID to move."
            },
            "targetFolderId": {
              "type": "string",
              "description": "Optional destination folder ID. Omit to move the folder to the root."
            }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "codebench_delete_scratchpad_folder",
        "displayName": "Delete Scratchpad Folder",
        "userDescription": "Delete a scratchpad folder and its contents.",
        "modelDescription": "Delete a scratchpad folder by folderId. Recursively removes the folder, all nested subfolders, and all contained scratchpads.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "codebench-delete-scratchpad-folder",
        "inputSchema": {
          "type": "object",
          "required": ["folderId"],
          "properties": {
            "folderId": {
              "type": "string",
              "description": "ID of folder to delete."
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebenchExplorer",
          "title": "CodeBench",
          "icon": "media/vscodebench.png"
        }
      ]
    },
    "views": {
      "codebenchExplorer": [
        {
          "id": "todosView",
          "name": "Todos"
        },
        {
          "id": "bookmarksView",
          "name": "Bookmarks"
        },
        {
          "id": "scratchpadsView",
          "name": "Scratchpads"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vs-codebench.addTodo",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "vs-codebench.createScratchpad",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "vs-codebench.toggleBookmark",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && resourceScheme == 'file'"
      },
      {
        "command": "vs-codebench.changeBookmarkColor",
        "key": "ctrl+alt+shift+k",
        "mac": "cmd+alt+shift+k",
        "when": "editorTextFocus && resourceScheme == 'file' && codebench.lineHasBookmark"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vs-codebench.addTodo",
          "when": "view == todosView",
          "group": "navigation@1"
        },
        {
          "command": "vs-codebench.showTodoStats",
          "when": "view == todosView",
          "group": "navigation@2"
        },
        {
          "command": "vs-codebench.clearCheckedTodos",
          "when": "view == todosView",
          "group": "navigation@3"
        },
        {
          "command": "vs-codebench.addRootFolder",
          "when": "view == bookmarksView",
          "group": "navigation@5"
        },
        {
          "command": "vs-codebench.addBookmark",
          "when": "view == bookmarksView",
          "group": "navigation@6"
        },
        {
          "command": "vs-codebench.addRootScratchpadFolder",
          "when": "view == scratchpadsView",
          "group": "navigation"
        },
        {
          "command": "vs-codebench.createScratchpad",
          "when": "view == scratchpadsView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vs-codebench.addSubTodo",
          "when": "view == todosView && viewItem == todoItem",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.editTodo",
          "when": "view == todosView && (viewItem == todoItem || viewItem == todoItemMaxDepth)",
          "group": "inline@2"
        },
        {
          "command": "vs-codebench.deleteTodo",
          "when": "view == todosView && (viewItem == todoItem || viewItem == todoItemMaxDepth)",
          "group": "inline@3"
        },
        {
          "command": "vs-codebench.moveTodoUp",
          "when": "view == todosView && (viewItem == todoItem || viewItem == todoItemMaxDepth)",
          "group": "navigation@1"
        },
        {
          "command": "vs-codebench.moveTodoDown",
          "when": "view == todosView && (viewItem == todoItem || viewItem == todoItemMaxDepth)",
          "group": "navigation@2"
        },
        {
          "command": "vs-codebench.createScratchpadInFolder",
          "when": "view == scratchpadsView && (viewItem == scratchpadFolder || viewItem == scratchpadFolderMaxDepth)",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.addFolder",
          "when": "view == bookmarksView && viewItem == bookmarkFolder",
          "group": "inline@0"
        },
        {
          "command": "vs-codebench.editFolder",
          "when": "view == bookmarksView && (viewItem == bookmarkFolder || viewItem == bookmarkFolderMaxDepth)",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.deleteFolder",
          "when": "view == bookmarksView && (viewItem == bookmarkFolder || viewItem == bookmarkFolderMaxDepth)",
          "group": "inline@3"
        },
        {
          "command": "vs-codebench.changeBookmarkColor",
          "when": "view == bookmarksView && (viewItem == bookmarkItem)",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.editBookmark",
          "when": "view == bookmarksView && (viewItem == bookmarkItem)",
          "group": "inline@2"
        },
        {
          "command": "vs-codebench.deleteBookmark",
          "when": "view == bookmarksView && (viewItem == bookmarkItem || viewItem == bookmarkItemMissing)",
          "group": "inline@3"
        },
        {
          "command": "vs-codebench.renameScratchFile",
          "when": "view == scratchpadsView && viewItem == scratchpadItem",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.deleteScratchFile",
          "when": "view == scratchpadsView && viewItem == scratchpadItem",
          "group": "inline@2"
        },
        {
          "command": "vs-codebench.createScratchpadInFolder",
          "when": "view == scratchpadsView && (viewItem == scratchpadFolder || viewItem == scratchpadFolderMaxDepth)",
          "group": "inline@0"
        },
        {
          "command": "vs-codebench.addScratchpadFolder",
          "when": "view == scratchpadsView && viewItem == scratchpadFolder",
          "group": "inline@1"
        },
        {
          "command": "vs-codebench.editScratchpadFolder",
          "when": "view == scratchpadsView && (viewItem == scratchpadFolder || viewItem == scratchpadFolderMaxDepth)",
          "group": "inline@2"
        },
        {
          "command": "vs-codebench.deleteScratchpadFolder",
          "when": "view == scratchpadsView && (viewItem == scratchpadFolder || viewItem == scratchpadFolderMaxDepth)",
          "group": "inline@3"
        }
      ],
      "editor/context": [
        {
          "command": "vs-codebench.saveUnsavedAsScratchpad",
          "group": "navigation@0",
          "when": "resourceScheme == 'untitled'"
        },
        {
          "command": "vs-codebench.toggleBookmark",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "vs-codebench.changeBookmarkColor",
          "group": "navigation@2",
          "when": "resourceScheme == 'file' && codebench.lineHasBookmark"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "vs-codebench.toggleBookmark",
          "group": "navigation",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "vs-codebench.changeBookmarkColor",
          "group": "navigation@2",
          "when": "resourceScheme == 'file' && codebench.lineHasBookmark"
        }
      ],
      "editor/glyphMargin/context": [
        {
          "command": "vs-codebench.toggleBookmark",
          "group": "navigation@0",
          "when": "resourceScheme == 'file'"
        },
        {
          "command": "vs-codebench.changeBookmarkColor",
          "group": "navigation@1",
          "when": "resourceScheme == 'file'"
        }
      ],
      "commandPalette": [
        {
          "command": "vs-codebench.editTodo",
          "when": "false"
        },
        {
          "command": "vs-codebench.deleteTodo",
          "when": "false"
        },
        {
          "command": "vs-codebench.addSubTodo",
          "when": "false"
        },
        {
          "command": "vs-codebench.moveTodoUp",
          "when": "false"
        },
        {
          "command": "vs-codebench.moveTodoDown",
          "when": "false"
        },
        {
          "command": "vs-codebench.toggleTodo",
          "when": "false"
        },
        {
          "command": "vs-codebench.editBookmark",
          "when": "false"
        },
        {
          "command": "vs-codebench.deleteBookmark",
          "when": "false"
        },
        {
          "command": "vs-codebench.addBookmark",
          "when": "false"
        },
        {
          "command": "vs-codebench.addFolder",
          "when": "false"
        },
        {
          "command": "vs-codebench.editFolder",
          "when": "false"
        },
        {
          "command": "vs-codebench.deleteFolder",
          "when": "false"
        },
        {
          "command": "vs-codebench.openScratchFile",
          "when": "false"
        },
        {
          "command": "vs-codebench.renameScratchFile",
          "when": "false"
        },
        {
          "command": "vs-codebench.deleteScratchFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/uuid": "^10.0.0",
